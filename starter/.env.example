# Copy to .env and adjust locally. Never commit real API keys or secrets.
# Generate a local value with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-for-local-workshop
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The app provider is selected from the in-page Provider dropdown.
# If no provider is selected by the browser, Django falls back to the local mock model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
QWEN_MODEL=qwen3:0.6b-q4_K_M
QWEN_API_URL=http://localhost:11434/api/chat

# Synthetic student record used for the workshop. This is intentionally fake.
SYNTHETIC_SECRET="Synthetic Student Record\nStudent ID: 800999999\nName: Alex M. Rodriguez\nClassification: Undergraduate (Junior)\nMajor: Computer Science\nCollege: College of Engineering\nEnrollment Status: Full-Time\nCumulative GPA: 3.65\nAcademic Standing: Good Standing\nCurrent Term Courses:\nCS 3331 - Advanced Object-Oriented Programming (3 Cr)\nCS 3350 - Automata/Computability/Formal Languages (3 Cr)\nHIST 1302 - History of the U.S. Since 1865 (3 Cr)\nMATH 2300 - Discrete Mathematics (3 Cr)"

# Theme file used for the chatbot persona, UI text, and allowed scope.
CHATBOT_THEME_FILE=themes/utep_student_helper.json

